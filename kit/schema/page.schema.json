{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/mmdemirbas/html-doc/main/kit/schema/page.schema.json",
  "title": "html-doc page",
  "description": "Source of truth for one renderable page. Authored as JSON; the kit's renderer maps the tree to Custom-Element DOM at load time.",
  "type": "object",
  "required": ["kind", "title", "blocks"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string", "description": "Optional schema URL for editor autocomplete." },
    "schema_version": { "type": "integer", "default": 1, "description": "Reader uses this to detect forward-compat issues." },
    "kind": { "const": "page" },
    "title": { "type": "string", "description": "Becomes the document <title> and the page cover's <h1>." },
    "meta": { "$ref": "#/$defs/meta" },
    "accent": {
      "type": "string",
      "description": "Per-page accent token. Either a kit-known name (teal, amber, indigo, ...) or a CSS color value."
    },
    "blocks": {
      "type": "array",
      "description": "Top-level content sequence: cover-level elements (tldr) then sections.",
      "items": { "$ref": "#/$defs/topBlock" }
    }
  },
  "$defs": {
    "meta": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "eyebrow": { "type": "string", "description": "Small label above the title, e.g. 'Implementation plan'." },
        "subtitle": { "type": "string" },
        "audience": { "type": "string" },
        "date": { "type": "string", "description": "ISO date or human string." },
        "updated": { "type": "string", "description": "Last-updated date — quiet trust signal under the cover meta row." },
        "read_time": { "type": "string", "description": "Like '~10 min read'." },
        "lang": { "type": "string", "description": "Per-page language override; otherwise project default applies." },
        "summary": { "type": "string", "description": "One-line summary, surfaced in nav tooltips and llms.txt." }
      }
    },

    "topBlock": {
      "oneOf": [
        { "$ref": "#/$defs/section" },
        { "$ref": "#/$defs/tldr" },
        { "$ref": "#/$defs/kpi-grid" }
      ]
    },

    "section": {
      "type": "object",
      "required": ["kind", "id", "title", "blocks"],
      "additionalProperties": false,
      "properties": {
        "kind": { "const": "section" },
        "id": { "type": "string", "description": "Anchor + TOC key. Should be unique within the page." },
        "title": { "type": "string" },
        "lead": { "type": "string", "description": "Optional one-paragraph lead under the heading." },
        "blocks": {
          "type": "array",
          "items": { "$ref": "#/$defs/contentBlock" }
        }
      }
    },

    "tldr": {
      "type": "object",
      "required": ["kind"],
      "additionalProperties": false,
      "properties": {
        "kind": { "const": "tldr" },
        "title": { "type": "string", "default": "TL;DR" },
        "summary": { "type": "string", "description": "Single-line headline." },
        "bullets": { "type": "array", "items": { "$ref": "#/$defs/richString" } }
      }
    },

    "kpi-grid": {
      "type": "object",
      "required": ["kind", "tiles"],
      "additionalProperties": false,
      "properties": {
        "kind": { "const": "kpi-grid" },
        "tiles": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["num", "label"],
            "additionalProperties": false,
            "properties": {
              "num": { "type": ["string", "number"] },
              "label": { "type": "string" }
            }
          }
        }
      }
    },

    "contentBlock": {
      "oneOf": [
        { "$ref": "#/$defs/paragraph" },
        { "$ref": "#/$defs/heading" },
        { "$ref": "#/$defs/callout" },
        { "$ref": "#/$defs/insight" },
        { "$ref": "#/$defs/info-tip" },
        { "$ref": "#/$defs/list" },
        { "$ref": "#/$defs/code" },
        { "$ref": "#/$defs/annotated-code" },
        { "$ref": "#/$defs/table" },
        { "$ref": "#/$defs/tldr" },
        { "$ref": "#/$defs/kpi-grid" },
        { "$ref": "#/$defs/step-flow" },
        { "$ref": "#/$defs/compare-grid" },
        { "$ref": "#/$defs/chart" },
        { "$ref": "#/$defs/diagram" },
        { "$ref": "#/$defs/live-snippet" },
        { "$ref": "#/$defs/example" }
      ]
    },

    "example": {
      "type": "object",
      "required": ["kind", "code", "render"],
      "additionalProperties": false,
      "description": "Code + rendered-result pair. Renders as a two-column grid (code on the left, live output on the right) on wide screens; collapses to a stacked layout below ~900px. Use to document every primitive in reference.json so the JSON shape and the visible result sit side-by-side.",
      "properties": {
        "kind": { "const": "example" },
        "title": { "type": "string", "description": "Optional small label shown above the pair." },
        "code": { "$ref": "#/$defs/code" },
        "render": { "$ref": "#/$defs/contentBlock", "description": "The block that the JSON source produces when run. Schema accepts any contentBlock, so a code example can demonstrate a callout, a chart, a table, etc." }
      }
    },

    "paragraph": {
      "type": "object",
      "required": ["kind", "content"],
      "additionalProperties": false,
      "properties": {
        "kind": { "const": "paragraph" },
        "content": { "$ref": "#/$defs/richString" },
        "bind": { "type": "string", "description": "Shared key for the cross-block hover-sync feature. Any two blocks with the same bind key flash together when either is hovered or focused." }
      }
    },

    "heading": {
      "type": "object",
      "required": ["kind", "level", "title"],
      "additionalProperties": false,
      "properties": {
        "kind": { "const": "heading" },
        "level": { "type": "integer", "minimum": 3, "maximum": 4 },
        "title": { "type": "string" },
        "id": { "type": "string" },
        "bind": { "type": "string" }
      }
    },

    "callout": {
      "type": "object",
      "required": ["kind"],
      "additionalProperties": false,
      "properties": {
        "kind": { "const": "callout" },
        "type": { "enum": ["warn", "warning", "caution", "danger", "success", "tip", "neutral", "note", "info"], "default": "neutral" },
        "title": { "type": "string" },
        "content": { "$ref": "#/$defs/richString" },
        "bind": { "type": "string" }
      }
    },

    "insight": {
      "type": "object",
      "required": ["kind", "content"],
      "additionalProperties": false,
      "properties": {
        "kind": { "const": "insight" },
        "content": { "$ref": "#/$defs/richString" }
      }
    },

    "info-tip": {
      "type": "object",
      "required": ["kind", "summary", "content"],
      "additionalProperties": false,
      "properties": {
        "kind": { "const": "info-tip" },
        "summary": { "type": "string", "description": "The collapsed label." },
        "content": {
          "type": "array",
          "items": { "$ref": "#/$defs/contentBlock" }
        }
      }
    },

    "list": {
      "type": "object",
      "required": ["kind", "items"],
      "additionalProperties": false,
      "properties": {
        "kind": { "const": "list" },
        "style": { "enum": ["bullet", "numbered"], "default": "bullet" },
        "items": {
          "type": "array",
          "items": { "$ref": "#/$defs/richString" }
        }
      }
    },

    "code": {
      "type": "object",
      "required": ["kind", "source"],
      "additionalProperties": false,
      "properties": {
        "kind": { "const": "code" },
        "language": { "type": "string" },
        "source": { "type": "string" }
      }
    },

    "table": {
      "type": "object",
      "required": ["kind"],
      "additionalProperties": false,
      "properties": {
        "kind":    { "const": "table" },
        "view": {
          "enum": ["table", "list", "cards", "board"],
          "description": "Pin the initial view shown by the table-chrome view toggle. Defaults to 'table'. Use 'board' on tables whose primary point is the kanban grouping — otherwise the reader sees a flat table by default and the kanban shape stays one click away."
        },
        "headers": {
          "type": "array",
          "items": { "$ref": "#/$defs/tableHeader" }
        },
        "rows": {
          "type": "array",
          "items": { "$ref": "#/$defs/tableRow" },
          "description": "Flat row form. Use either rows OR groups, not both."
        },
        "groups": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["rows"],
            "additionalProperties": false,
            "properties": {
              "title": { "$ref": "#/$defs/richString" },
              "rows":  {
                "type": "array",
                "items": { "$ref": "#/$defs/tableRow" }
              }
            }
          },
          "description": "Grouped row form — chrome.js renders each group title as a subhead row across the views."
        }
      }
    },

    "tableHeader": {
      "description": "Either a plain header label (string / inline-array) or an object form with optional chip-filter and/or board-lane-order declarations.",
      "oneOf": [
        { "$ref": "#/$defs/richString" },
        {
          "type": "object",
          "required": ["label"],
          "additionalProperties": false,
          "properties": {
            "label":  { "$ref": "#/$defs/richString" },
            "filter": { "const": "chips" },
            "values": {
              "type": "array",
              "items": { "type": "string" },
              "minItems": 1,
              "description": "Ordered chip values for chip-filter columns. Cells should declare one (or more) of these via the object cell form."
            },
            "boardOrder": {
              "type": "array",
              "items": { "type": "string" },
              "minItems": 1,
              "description": "When this column drives the board view's group-by, render lanes in this order. Values present in row data but missing from boardOrder render at the end in first-occurrence order."
            }
          },
          "dependentRequired": {
            "filter": ["values"]
          },
          "anyOf": [
            { "required": ["filter"] },
            { "required": ["boardOrder"] }
          ]
        }
      ]
    },

    "tableRow": {
      "description": "Row payload — either a positional array of cells or an object with cells + optional row-level affordances (link target, classes).",
      "oneOf": [
        {
          "type": "array",
          "items": { "$ref": "#/$defs/tableCell" }
        },
        {
          "type": "object",
          "required": ["cells"],
          "additionalProperties": true,
          "properties": {
            "cells": {
              "type": "array",
              "items": { "$ref": "#/$defs/tableCell" }
            }
          }
        }
      ]
    },

    "tableCell": {
      "description": "Either a plain rich-string value or an object form carrying explicit chip values (supports multi-valued cells).",
      "oneOf": [
        { "$ref": "#/$defs/richString" },
        {
          "type": "object",
          "required": ["values"],
          "additionalProperties": false,
          "properties": {
            "value": { "$ref": "#/$defs/richString" },
            "values": {
              "type": "array",
              "items": { "type": "string" },
              "minItems": 1,
              "description": "Chip values for this cell. May contain multiple to mark the row against more than one chip."
            }
          }
        }
      ]
    },

    "annotated-code": {
      "type": "object",
      "required": ["kind", "source"],
      "additionalProperties": false,
      "properties": {
        "kind": { "const": "annotated-code" },
        "language": { "type": "string" },
        "source": { "type": "string", "description": "Code body. Use (1), (2)... as inline markers; each matches an annotation by id. Annotations may also declare `lines` / `match` externally and skip the inline marker." },
        "annotations": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "content"],
            "additionalProperties": false,
            "properties": {
              "id":      { "type": "integer", "minimum": 1 },
              "content": { "type": "string", "description": "HTML snippet. Allowed inline markup: <code>, <strong>, <em>, <a>." },
              "lines": {
                "type": "string",
                "description": "Optional line spec — '3' for a single line, '1-3' for a range, '1,5-7' for mixed. Hovering the marker highlights every listed line; when no inline (N) marker is present, the chip auto-places on the first listed line. Line numbers are 1-based and match the gutter."
              },
              "match": {
                "oneOf": [
                  { "type": "string" },
                  { "type": "array", "items": { "type": "string" }, "minItems": 1 }
                ],
                "description": "Optional substring(s) of the source. Each occurrence is highlighted on marker hover, so you can point at a token without polluting the source with (N)."
              }
            }
          }
        }
      }
    },

    "step-flow": {
      "type": "object",
      "required": ["kind", "steps"],
      "additionalProperties": false,
      "properties": {
        "kind": { "const": "step-flow" },
        "steps": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["title"],
            "additionalProperties": false,
            "properties": {
              "num": { "type": ["string", "number"] },
              "title": { "type": "string" },
              "meta": { "type": "string", "description": "Small meta line (estimate, files, risk)." },
              "content": { "$ref": "#/$defs/richString" },
              "href": { "type": "string", "description": "Optional. When set, the entire step card is wrapped in an anchor pointing here — keyboard reachable, click-targetable, no 'Open X' link text needed in content." }
            }
          }
        }
      }
    },

    "compare-grid": {
      "type": "object",
      "required": ["kind", "cards"],
      "additionalProperties": false,
      "description": "N-card comparison grid. Pick the card accent via verdict (or accent — alias). Mix content (rich text body), items (bullet list), and blocks (any contentBlock — callouts, code, charts, tables) freely; they render in source order. Both verdict and accent are optional and default to neutral.",
      "properties": {
        "kind": { "const": "compare-grid" },
        "cards": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["title"],
            "additionalProperties": false,
            "properties": {
              "verdict": {
                "enum": ["good", "bad", "neutral", "in", "out"],
                "default": "neutral",
                "description": "Quality / scope shorthand: good (success border), bad (danger), in (success — was scope-grid status:in), out (muted), neutral (default). Use `accent` instead when you need to match the broader kit token vocabulary; both fields are honoured but accent wins on conflict."
              },
              "accent": {
                "enum": ["accent", "warn", "danger", "success", "muted", "neutral"],
                "description": "Card accent in the kit's standard color tokens. Wins over verdict if both are set. Use this when verdict's good/bad/in/out feels too arbitrary — accent maps directly to the same colour vocabulary as charts and callouts."
              },
              "title": { "type": "string" },
              "content": { "$ref": "#/$defs/richString", "description": "Rich-text body. Combine with items / blocks, or use any subset alone." },
              "items": {
                "type": "array",
                "items": { "$ref": "#/$defs/richString" },
                "description": "Bullet list inside the card. Renders below content when both are present."
              },
              "blocks": {
                "type": "array",
                "items": { "$ref": "#/$defs/contentBlock" },
                "description": "Rich block content inside the card — callouts, code samples, tables, charts, anything from contentBlock. Renders after items. Use blocks when a card needs a worked example or a structured comparison; use items for a plain bullet list."
              }
            }
          }
        }
      }
    },

    "chart": {
      "type": "object",
      "required": ["kind", "type"],
      "additionalProperties": false,
      "description": "Data-driven chart. The `type` field picks the render mode: Cartesian (scatter / line / area / bubble / quadrant) share an SVG plot with axes, pan, zoom, log scale, and PNG export; bar variants render label/value bars; donut renders a distribution arc. Each type has its own payload shape — the renderer dispatches by `type` so unused fields are simply ignored.",
      "properties": {
        "kind": { "const": "chart" },
        "type": {
          "enum": ["scatter", "line", "area", "bubble", "quadrant", "bar", "stacked-bar", "grouped-bar", "donut", "heatmap", "sparkline", "waffle", "gauge", "radar", "box-plot", "bullet", "slope", "histogram", "calendar-heatmap", "treemap", "ridgeline", "funnel", "sankey", "network", "scatter-matrix", "parallel-coordinates"],
          "description": "Render mode. scatter / line / area / bubble / quadrant — Cartesian SVG. bar / stacked-bar / grouped-bar — horizontal CSS bars. donut — distribution arc. heatmap — N×M coloured cell grid. sparkline — inline mini line/area/bar. waffle — N×M unit-cell breakdown. gauge — single value 0→max arc. radar — multi-axis comparison polygons. box-plot — quartile + whisker distribution summary. bullet — actual-vs-target horizontal track. slope — two-time-point comparison. histogram — frequency by bin. calendar-heatmap — date-of-year × day-of-week activity grid. treemap — nested area-proportional rectangles. ridgeline — stacked small-distributions. funnel — conversion stages with drop-off. sankey — flow / share between stages with curved ribbons. network — node-link force-relaxed graph. scatter-matrix — N×N grid of mini scatters for multivariate correlation. parallel-coordinates — multi-axis polyline per record."
        },
        "title": { "type": "string" },
        "x_label": { "type": "string", "description": "Cartesian only (scatter / line / area / bubble / quadrant)." },
        "y_label": { "type": "string", "description": "Cartesian only." },
        "series": {
          "type": "array",
          "description": "Cartesian or stacked-bar / grouped-bar series. For Cartesian: each series carries `data: [{x, y, label, size?}]`. For stacked-bar / grouped-bar: each series carries `values: [number]` aligned to `categories`.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "label": { "type": "string" },
              "color": { "enum": ["accent", "warn", "danger", "success", "muted"], "default": "accent" },
              "data": {
                "type": "array",
                "description": "Cartesian payload — list of points.",
                "items": {
                  "type": "object",
                  "required": ["x", "y"],
                  "additionalProperties": false,
                  "properties": {
                    "x": { "type": "number" },
                    "y": { "type": "number" },
                    "label": { "type": "string" },
                    "size": { "type": "number", "description": "Bubble only. Drives the dot radius (sqrt-scaled so dot area is proportional to size)." }
                  }
                }
              },
              "values": {
                "type": "array",
                "description": "stacked-bar / grouped-bar payload — one numeric value per entry in `categories`.",
                "items": { "type": "number" }
              }
            }
          }
        },
        "rows": {
          "type": "array",
          "description": "Bar only. Required when type is bar. One row per bar.",
          "items": {
            "type": "object",
            "required": ["label", "value"],
            "additionalProperties": false,
            "properties": {
              "label": { "type": "string" },
              "value": { "type": "number" },
              "display": { "type": "string", "description": "Override the right-hand readout (e.g. '95 / 100' instead of '95')." },
              "color": { "enum": ["accent", "warn", "danger", "success"], "default": "accent" }
            }
          }
        },
        "max": { "type": "number", "description": "Bar / stacked-bar / grouped-bar — full-width value. Gauge — arc end (required). Defaults to the largest row value (bar) or the largest category total (stacked) / category max (grouped)." },
        "categories": {
          "type": "array",
          "description": "stacked-bar / grouped-bar — ordered list of category labels (rows of the chart). Each series.values[] index aligns to this list.",
          "items": { "type": "string" },
          "minItems": 1
        },
        "quadrants": {
          "type": "object",
          "description": "Quadrant chart only. Splits the plot into four regions with reference lines at (x, y) and optionally names each quadrant.",
          "required": ["x", "y"],
          "additionalProperties": false,
          "properties": {
            "x": { "type": "number", "description": "Vertical reference line position on the x-axis." },
            "y": { "type": "number", "description": "Horizontal reference line position on the y-axis." },
            "labels": {
              "type": "array",
              "description": "Four labels in order [top-left, top-right, bottom-left, bottom-right]. Use empty strings to skip a corner.",
              "items": { "type": "string" },
              "minItems": 4,
              "maxItems": 4
            }
          }
        },
        "slices": {
          "type": "array",
          "description": "donut / pie only. Each slice is a labelled value; the renderer normalises to 100%.",
          "items": {
            "type": "object",
            "required": ["label", "value"],
            "additionalProperties": false,
            "properties": {
              "label": { "type": "string" },
              "value": { "type": "number", "minimum": 0 },
              "color": { "enum": ["accent", "warn", "danger", "success", "muted"], "default": "accent" }
            }
          },
          "minItems": 2
        },

        "cells": {
          "type": "array",
          "description": "heatmap only. 2D matrix — outer array is rows, inner array is columns. Length of outer ≥ 1; every inner row must have the same length.",
          "items": {
            "type": "array",
            "items": { "type": "number" }
          },
          "minItems": 1
        },
        "row_labels": {
          "type": "array",
          "description": "heatmap row labels (left edge). Length should match cells.length when supplied.",
          "items": { "type": "string" }
        },
        "col_labels": {
          "type": "array",
          "description": "heatmap column labels (top edge). Length should match cells[0].length when supplied.",
          "items": { "type": "string" }
        },
        "scale": {
          "enum": ["sequential", "diverging"],
          "description": "heatmap palette family. sequential is one-sided (low → high), diverging is two-sided (negative ← centre → positive).",
          "default": "sequential"
        },
        "domain": {
          "type": "array",
          "description": "heatmap value domain [min, max] for the colour mapping. Defaults to the data's own min / max.",
          "items": { "type": "number" },
          "minItems": 2,
          "maxItems": 2
        },

        "values": {
          "type": "array",
          "description": "sparkline only. Sequence of numeric values rendered as an inline line / area / bar.",
          "items": { "type": "number" },
          "minItems": 1
        },
        "variant": {
          "enum": ["line", "area", "bar"],
          "description": "sparkline render variant. Defaults to line.",
          "default": "line"
        },
        "end_label": {
          "type": "string",
          "description": "sparkline only. Small caption shown to the right of the curve (e.g. ‘62%’, ‘↗’)."
        },

        "total": {
          "type": "number",
          "description": "waffle / bullet — denominator. waffle: cell count when segments don't sum to it. bullet: max value.",
          "minimum": 1
        },
        "grid_rows": {
          "type": "integer",
          "description": "waffle grid height (rows). Defaults to 10.",
          "minimum": 1,
          "default": 10
        },
        "grid_cols": {
          "type": "integer",
          "description": "waffle grid width (columns). Defaults to 10.",
          "minimum": 1,
          "default": 10
        },
        "segments": {
          "type": "array",
          "description": "waffle / funnel segments. Each carries a label + count; cells coloured by category.",
          "items": {
            "type": "object",
            "required": ["label", "count"],
            "additionalProperties": false,
            "properties": {
              "label": { "type": "string" },
              "count": { "type": "number", "minimum": 0 },
              "color": { "enum": ["accent", "warn", "danger", "success", "muted"], "default": "accent" }
            }
          },
          "minItems": 1
        },

        "value": {
          "type": "number",
          "description": "gauge — current value. Mapped onto a semicircular arc between min and max."
        },
        "min": { "type": "number", "description": "gauge — arc start (default 0)." },
        "target": { "type": "number", "description": "gauge / bullet — optional target tick." },
        "label": { "type": "string", "description": "gauge / bullet — caption rendered under the value." },
        "zones": {
          "type": "array",
          "description": "gauge / bullet — coloured threshold bands rendered behind the value track.",
          "items": {
            "type": "object",
            "required": ["from", "to"],
            "additionalProperties": false,
            "properties": {
              "from": { "type": "number" },
              "to":   { "type": "number" },
              "tone": { "enum": ["accent", "warn", "danger", "success", "muted"], "default": "muted" }
            }
          }
        },

        "axes": {
          "type": "array",
          "description": "radar — N spokes radiating from centre. Each carries a label and optional per-axis max.",
          "items": {
            "type": "object",
            "required": ["label"],
            "additionalProperties": false,
            "properties": {
              "label": { "type": "string" },
              "max":   { "type": "number", "description": "Per-axis maximum (defaults to scale=shared)." }
            }
          },
          "minItems": 3
        },

        "boxes": {
          "type": "array",
          "description": "box-plot — one box per row. Carries quartiles + whiskers + optional outliers.",
          "items": {
            "type": "object",
            "required": ["label", "q1", "median", "q3", "min", "max"],
            "additionalProperties": false,
            "properties": {
              "label":    { "type": "string" },
              "min":      { "type": "number" },
              "q1":       { "type": "number" },
              "median":   { "type": "number" },
              "q3":       { "type": "number" },
              "max":      { "type": "number" },
              "outliers": { "type": "array", "items": { "type": "number" } },
              "color":    { "enum": ["accent", "warn", "danger", "success", "muted"], "default": "accent" }
            }
          },
          "minItems": 1
        },

        "tracks": {
          "type": "array",
          "description": "bullet — one row per metric. Each: { label, value, target?, max, zones? }.",
          "items": {
            "type": "object",
            "required": ["label", "value", "max"],
            "additionalProperties": false,
            "properties": {
              "label":  { "type": "string" },
              "value":  { "type": "number" },
              "target": { "type": "number" },
              "max":    { "type": "number" },
              "color":  { "enum": ["accent", "warn", "danger", "success", "muted"], "default": "accent" },
              "zones":  {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["from", "to"],
                  "additionalProperties": false,
                  "properties": {
                    "from": { "type": "number" },
                    "to":   { "type": "number" },
                    "tone": { "enum": ["accent", "warn", "danger", "success", "muted"], "default": "muted" }
                  }
                }
              }
            }
          },
          "minItems": 1
        },

        "from_label": { "type": "string", "description": "slope — left-edge label (default ‘Before’)." },
        "to_label":   { "type": "string", "description": "slope — right-edge label (default ‘After’)." },
        "items": {
          "type": "array",
          "description": "slope — one entity per row, two paired values.",
          "items": {
            "type": "object",
            "required": ["label", "from", "to"],
            "additionalProperties": false,
            "properties": {
              "label":  { "type": "string" },
              "from":   { "type": "number" },
              "to":     { "type": "number" },
              "color":  { "enum": ["accent", "warn", "danger", "success", "muted"], "default": "accent" }
            }
          },
          "minItems": 1
        },

        "bins": {
          "type": "array",
          "description": "histogram — pre-binned numeric distribution. Each entry: {lo, hi, count}. Bins should be contiguous and sorted by lo.",
          "items": {
            "type": "object",
            "required": ["lo", "hi", "count"],
            "additionalProperties": false,
            "properties": {
              "lo":    { "type": "number" },
              "hi":    { "type": "number" },
              "count": { "type": "number", "minimum": 0 }
            }
          },
          "minItems": 1
        },

        "year": {
          "type": "integer",
          "description": "calendar-heatmap — calendar year to render. If absent, derived from the keys of `date_values` (assumes all share the same year)."
        },
        "date_values": {
          "type": "object",
          "description": "calendar-heatmap — map of ISO date (YYYY-MM-DD) → numeric value. Days absent from the map render as empty cells.",
          "additionalProperties": { "type": "number" }
        },

        "tree": {
          "type": "array",
          "description": "treemap — flat list of leaves; one rectangle per entry, area proportional to `value`. Nested recursion via optional `children` is reserved for a later schema version.",
          "items": {
            "type": "object",
            "required": ["label", "value"],
            "additionalProperties": false,
            "properties": {
              "label": { "type": "string" },
              "value": { "type": "number", "minimum": 0 },
              "color": { "enum": ["accent", "warn", "danger", "success", "muted"], "default": "accent" }
            }
          },
          "minItems": 1
        },

        "distributions": {
          "type": "array",
          "description": "ridgeline — one row per distribution; each is a small histogram-like ridge. `values` is a flat sample (each cell counted with a fixed bin width derived from the global min/max).",
          "items": {
            "type": "object",
            "required": ["label", "values"],
            "additionalProperties": false,
            "properties": {
              "label":  { "type": "string" },
              "values": { "type": "array", "items": { "type": "number" }, "minItems": 1 },
              "color":  { "enum": ["accent", "warn", "danger", "success", "muted"], "default": "accent" }
            }
          },
          "minItems": 2
        },

        "stages": {
          "type": "array",
          "description": "funnel — ordered conversion stages. Each: {label, value, color?}. Drop-off between adjacent stages is shown as a tapered band.",
          "items": {
            "type": "object",
            "required": ["label", "value"],
            "additionalProperties": false,
            "properties": {
              "label": { "type": "string" },
              "value": { "type": "number", "minimum": 0 },
              "color": { "enum": ["accent", "warn", "danger", "success", "muted"], "default": "accent" }
            }
          },
          "minItems": 2
        },

        "nodes": {
          "type": "array",
          "description": "sankey / network — node list. Each: {id (string, unique), label?, color?}. For sankey, the renderer derives left-to-right column placement from the link graph (BFS depth). For network, position is force-relaxed at render time from the link adjacency.",
          "items": {
            "type": "object",
            "required": ["id"],
            "additionalProperties": false,
            "properties": {
              "id":    { "type": "string" },
              "label": { "type": "string" },
              "color": { "enum": ["accent", "warn", "danger", "success", "muted"], "default": "accent" }
            }
          },
          "minItems": 2
        },
        "links": {
          "type": "array",
          "description": "sankey / network — directed link list. Each: {source, target, value?, label?}. source and target reference node ids. value drives the ribbon thickness (sankey) or edge weight (network).",
          "items": {
            "type": "object",
            "required": ["source", "target"],
            "additionalProperties": false,
            "properties": {
              "source": { "type": "string" },
              "target": { "type": "string" },
              "value":  { "type": "number", "minimum": 0 },
              "label":  { "type": "string" }
            }
          },
          "minItems": 1
        },
        "variables": {
          "type": "array",
          "description": "scatter-matrix / parallel-coordinates — variable definitions. Each: {key, label?, domain?: [lo, hi]}. domain is optional — when omitted the renderer derives it from records.",
          "items": {
            "type": "object",
            "required": ["key"],
            "additionalProperties": false,
            "properties": {
              "key":    { "type": "string" },
              "label":  { "type": "string" },
              "domain": {
                "type": "array",
                "minItems": 2,
                "maxItems": 2,
                "items": { "type": "number" }
              }
            }
          },
          "minItems": 2
        },
        "records": {
          "type": "array",
          "description": "scatter-matrix / parallel-coordinates — record list. Each record is an object keyed by variable id. Optional `_label` and `_color` (one of accent / warn / danger / success / muted) tag the record visually.",
          "items": {
            "type": "object",
            "additionalProperties": true
          },
          "minItems": 2
        }
      },
      "allOf": [
        {
          "if": { "properties": { "type": { "const": "bar" } }, "required": ["type"] },
          "then": { "required": ["rows"] }
        },
        {
          "if": { "properties": { "type": { "enum": ["scatter", "line", "area", "bubble", "quadrant"] } }, "required": ["type"] },
          "then": { "required": ["series"] }
        },
        {
          "if": { "properties": { "type": { "enum": ["stacked-bar", "grouped-bar"] } }, "required": ["type"] },
          "then": { "required": ["categories", "series"] }
        },
        {
          "if": { "properties": { "type": { "const": "quadrant" } }, "required": ["type"] },
          "then": { "required": ["quadrants"] }
        },
        {
          "if": { "properties": { "type": { "const": "donut" } }, "required": ["type"] },
          "then": { "required": ["slices"] }
        },
        {
          "if": { "properties": { "type": { "const": "heatmap" } }, "required": ["type"] },
          "then": { "required": ["cells"] }
        },
        {
          "if": { "properties": { "type": { "const": "sparkline" } }, "required": ["type"] },
          "then": { "required": ["values"] }
        },
        {
          "if": { "properties": { "type": { "const": "waffle" } }, "required": ["type"] },
          "then": { "required": ["segments"] }
        },
        {
          "if": { "properties": { "type": { "const": "gauge" } }, "required": ["type"] },
          "then": { "required": ["value", "max"] }
        },
        {
          "if": { "properties": { "type": { "const": "radar" } }, "required": ["type"] },
          "then": { "required": ["axes", "series"] }
        },
        {
          "if": { "properties": { "type": { "const": "box-plot" } }, "required": ["type"] },
          "then": { "required": ["boxes"] }
        },
        {
          "if": { "properties": { "type": { "const": "bullet" } }, "required": ["type"] },
          "then": { "required": ["tracks"] }
        },
        {
          "if": { "properties": { "type": { "const": "slope" } }, "required": ["type"] },
          "then": { "required": ["items"] }
        },
        {
          "if": { "properties": { "type": { "const": "histogram" } }, "required": ["type"] },
          "then": { "required": ["bins"] }
        },
        {
          "if": { "properties": { "type": { "const": "calendar-heatmap" } }, "required": ["type"] },
          "then": { "required": ["date_values"] }
        },
        {
          "if": { "properties": { "type": { "const": "treemap" } }, "required": ["type"] },
          "then": { "required": ["tree"] }
        },
        {
          "if": { "properties": { "type": { "const": "ridgeline" } }, "required": ["type"] },
          "then": { "required": ["distributions"] }
        },
        {
          "if": { "properties": { "type": { "const": "funnel" } }, "required": ["type"] },
          "then": { "required": ["stages"] }
        },
        {
          "if": { "properties": { "type": { "enum": ["sankey", "network"] } }, "required": ["type"] },
          "then": { "required": ["nodes", "links"] }
        },
        {
          "if": { "properties": { "type": { "enum": ["scatter-matrix", "parallel-coordinates"] } }, "required": ["type"] },
          "then": { "required": ["variables", "records"] }
        }
      ]
    },

    "diagram": {
      "type": "object",
      "required": ["kind", "source"],
      "additionalProperties": false,
      "properties": {
        "kind": { "const": "diagram" },
        "caption": { "type": "string" },
        "source": { "type": "string", "description": "Mermaid source. Sequence / flow / state / gantt / class supported." }
      }
    },

    "live-snippet": {
      "type": "object",
      "required": ["kind", "source"],
      "additionalProperties": false,
      "properties": {
        "kind": { "const": "live-snippet" },
        "language": { "enum": ["html-css-js"], "default": "html-css-js" },
        "label": { "type": "string" },
        "source": { "type": "string" }
      }
    },

    "richString": {
      "description": "Either a plain string or an array mixing strings with inline nodes.",
      "oneOf": [
        { "type": "string" },
        {
          "type": "array",
          "items": {
            "oneOf": [
              { "type": "string" },
              { "$ref": "#/$defs/inlineNode" }
            ]
          }
        }
      ]
    },

    "inlineNode": {
      "oneOf": [
        {
          "type": "object",
          "required": ["kind"],
          "additionalProperties": false,
          "properties": {
            "kind": { "const": "glossary-term" },
            "term": { "type": "string" },
            "in": { "type": "string", "description": "Disambiguating domain." },
            "lang": { "type": "string", "description": "Override the project language for this instance." },
            "text": { "type": "string", "description": "Visible text; defaults to term." }
          }
        },
        {
          "type": "object",
          "required": ["kind", "name"],
          "additionalProperties": false,
          "properties": {
            "kind": { "const": "ext-ref" },
            "name": { "type": "string" },
            "in": { "type": "string" },
            "lang": { "type": "string" },
            "text": { "type": "string" }
          }
        },
        {
          "type": "object",
          "required": ["kind", "text"],
          "additionalProperties": false,
          "properties": {
            "kind": { "enum": ["code", "em", "strong"] },
            "text": { "type": "string" }
          }
        },
        {
          "type": "object",
          "required": ["kind", "text", "href"],
          "additionalProperties": false,
          "properties": {
            "kind": { "const": "link" },
            "text": { "type": "string" },
            "href": { "type": "string" }
          }
        },
        {
          "type": "object",
          "required": ["kind", "text"],
          "additionalProperties": false,
          "description": "Sanitised inline HTML pass-through. The Markdown converter emits this for tags inside the small allowlist (a, code, em, strong, span, sup, sub, br, mark, kbd, samp, del, ins, abbr); the renderer drops the text into an inline span via innerHTML. Authors writing JSON pages should prefer the typed inline kinds — html is the markdown escape hatch, not a recommended primitive.",
          "properties": {
            "kind": { "const": "html" },
            "text": { "type": "string" }
          }
        }
      ]
    }
  }
}
