{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/mmdemirbas/html-doc/main/kit/schema/page.schema.json",
  "title": "html-doc page",
  "description": "Source of truth for one renderable page. Authored as JSON; the kit's renderer maps the tree to Custom-Element DOM at load time.",
  "type": "object",
  "required": ["kind", "title", "blocks"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string", "description": "Optional schema URL for editor autocomplete." },
    "schema_version": { "type": "integer", "default": 1, "description": "Reader uses this to detect forward-compat issues." },
    "kind": { "const": "page" },
    "title": { "type": "string", "description": "Becomes the document <title> and the page cover's <h1>." },
    "meta": { "$ref": "#/$defs/meta" },
    "accent": {
      "type": "string",
      "description": "Per-page accent token. Either a kit-known name (teal, amber, indigo, ...) or a CSS color value."
    },
    "blocks": {
      "type": "array",
      "description": "Top-level content sequence: cover-level elements (tldr) then sections.",
      "items": { "$ref": "#/$defs/topBlock" }
    }
  },
  "$defs": {
    "meta": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "eyebrow": { "type": "string", "description": "Small label above the title, e.g. 'Implementation plan'." },
        "subtitle": { "type": "string" },
        "audience": { "type": "string" },
        "date": { "type": "string", "description": "ISO date or human string." },
        "updated": { "type": "string", "description": "Last-updated date — quiet trust signal under the cover meta row." },
        "read_time": { "type": "string", "description": "Like '~10 min read'." },
        "lang": { "type": "string", "description": "Per-page language override; otherwise project default applies." },
        "summary": { "type": "string", "description": "One-line summary, surfaced in nav tooltips and llms.txt." }
      }
    },

    "topBlock": {
      "oneOf": [
        { "$ref": "#/$defs/section" },
        { "$ref": "#/$defs/tldr" },
        { "$ref": "#/$defs/kpi-grid" }
      ]
    },

    "section": {
      "type": "object",
      "required": ["kind", "id", "title", "blocks"],
      "additionalProperties": false,
      "properties": {
        "kind": { "const": "section" },
        "id": { "type": "string", "description": "Anchor + TOC key. Should be unique within the page." },
        "title": { "type": "string" },
        "lead": { "type": "string", "description": "Optional one-paragraph lead under the heading." },
        "blocks": {
          "type": "array",
          "items": { "$ref": "#/$defs/contentBlock" }
        }
      }
    },

    "tldr": {
      "type": "object",
      "required": ["kind"],
      "additionalProperties": false,
      "properties": {
        "kind": { "const": "tldr" },
        "title": { "type": "string", "default": "TL;DR" },
        "summary": { "type": "string", "description": "Single-line headline." },
        "bullets": { "type": "array", "items": { "$ref": "#/$defs/richString" } }
      }
    },

    "kpi-grid": {
      "type": "object",
      "required": ["kind", "tiles"],
      "additionalProperties": false,
      "properties": {
        "kind": { "const": "kpi-grid" },
        "tiles": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["num", "label"],
            "additionalProperties": false,
            "properties": {
              "num": { "type": ["string", "number"] },
              "label": { "type": "string" }
            }
          }
        }
      }
    },

    "contentBlock": {
      "oneOf": [
        { "$ref": "#/$defs/paragraph" },
        { "$ref": "#/$defs/heading" },
        { "$ref": "#/$defs/callout" },
        { "$ref": "#/$defs/insight" },
        { "$ref": "#/$defs/info-tip" },
        { "$ref": "#/$defs/list" },
        { "$ref": "#/$defs/code" },
        { "$ref": "#/$defs/annotated-code" },
        { "$ref": "#/$defs/table" },
        { "$ref": "#/$defs/tldr" },
        { "$ref": "#/$defs/kpi-grid" },
        { "$ref": "#/$defs/step-flow" },
        { "$ref": "#/$defs/compare-grid" },
        { "$ref": "#/$defs/chart" },
        { "$ref": "#/$defs/diagram" },
        { "$ref": "#/$defs/live-snippet" }
      ]
    },

    "paragraph": {
      "type": "object",
      "required": ["kind", "content"],
      "additionalProperties": false,
      "properties": {
        "kind": { "const": "paragraph" },
        "content": { "$ref": "#/$defs/richString" },
        "bind": { "type": "string", "description": "Shared key for the cross-block hover-sync feature. Any two blocks with the same bind key flash together when either is hovered or focused." }
      }
    },

    "heading": {
      "type": "object",
      "required": ["kind", "level", "title"],
      "additionalProperties": false,
      "properties": {
        "kind": { "const": "heading" },
        "level": { "type": "integer", "minimum": 3, "maximum": 4 },
        "title": { "type": "string" },
        "id": { "type": "string" },
        "bind": { "type": "string" }
      }
    },

    "callout": {
      "type": "object",
      "required": ["kind"],
      "additionalProperties": false,
      "properties": {
        "kind": { "const": "callout" },
        "type": { "enum": ["warn", "warning", "caution", "danger", "success", "tip", "neutral", "note", "info"], "default": "neutral" },
        "title": { "type": "string" },
        "content": { "$ref": "#/$defs/richString" },
        "bind": { "type": "string" }
      }
    },

    "insight": {
      "type": "object",
      "required": ["kind", "content"],
      "additionalProperties": false,
      "properties": {
        "kind": { "const": "insight" },
        "content": { "$ref": "#/$defs/richString" }
      }
    },

    "info-tip": {
      "type": "object",
      "required": ["kind", "summary", "content"],
      "additionalProperties": false,
      "properties": {
        "kind": { "const": "info-tip" },
        "summary": { "type": "string", "description": "The collapsed label." },
        "content": {
          "type": "array",
          "items": { "$ref": "#/$defs/contentBlock" }
        }
      }
    },

    "list": {
      "type": "object",
      "required": ["kind", "items"],
      "additionalProperties": false,
      "properties": {
        "kind": { "const": "list" },
        "style": { "enum": ["bullet", "numbered"], "default": "bullet" },
        "items": {
          "type": "array",
          "items": { "$ref": "#/$defs/richString" }
        }
      }
    },

    "code": {
      "type": "object",
      "required": ["kind", "source"],
      "additionalProperties": false,
      "properties": {
        "kind": { "const": "code" },
        "language": { "type": "string" },
        "source": { "type": "string" }
      }
    },

    "table": {
      "type": "object",
      "required": ["kind"],
      "additionalProperties": false,
      "properties": {
        "kind":    { "const": "table" },
        "headers": {
          "type": "array",
          "items": { "$ref": "#/$defs/tableHeader" }
        },
        "rows": {
          "type": "array",
          "items": { "$ref": "#/$defs/tableRow" },
          "description": "Flat row form. Use either rows OR groups, not both."
        },
        "groups": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["rows"],
            "additionalProperties": false,
            "properties": {
              "title": { "$ref": "#/$defs/richString" },
              "rows":  {
                "type": "array",
                "items": { "$ref": "#/$defs/tableRow" }
              }
            }
          },
          "description": "Grouped row form — chrome.js renders each group title as a subhead row across the views."
        }
      }
    },

    "tableHeader": {
      "description": "Either a plain header label (string / inline-array) or an object form with optional chip-filter and/or board-lane-order declarations.",
      "oneOf": [
        { "$ref": "#/$defs/richString" },
        {
          "type": "object",
          "required": ["label"],
          "additionalProperties": false,
          "properties": {
            "label":  { "$ref": "#/$defs/richString" },
            "filter": { "const": "chips" },
            "values": {
              "type": "array",
              "items": { "type": "string" },
              "minItems": 1,
              "description": "Ordered chip values for chip-filter columns. Cells should declare one (or more) of these via the object cell form."
            },
            "boardOrder": {
              "type": "array",
              "items": { "type": "string" },
              "minItems": 1,
              "description": "When this column drives the board view's group-by, render lanes in this order. Values present in row data but missing from boardOrder render at the end in first-occurrence order."
            }
          },
          "dependentRequired": {
            "filter": ["values"]
          },
          "anyOf": [
            { "required": ["filter"] },
            { "required": ["boardOrder"] }
          ]
        }
      ]
    },

    "tableRow": {
      "description": "Row payload — either a positional array of cells or an object with cells + optional row-level affordances (link target, classes).",
      "oneOf": [
        {
          "type": "array",
          "items": { "$ref": "#/$defs/tableCell" }
        },
        {
          "type": "object",
          "required": ["cells"],
          "additionalProperties": true,
          "properties": {
            "cells": {
              "type": "array",
              "items": { "$ref": "#/$defs/tableCell" }
            }
          }
        }
      ]
    },

    "tableCell": {
      "description": "Either a plain rich-string value or an object form carrying explicit chip values (supports multi-valued cells).",
      "oneOf": [
        { "$ref": "#/$defs/richString" },
        {
          "type": "object",
          "required": ["values"],
          "additionalProperties": false,
          "properties": {
            "value": { "$ref": "#/$defs/richString" },
            "values": {
              "type": "array",
              "items": { "type": "string" },
              "minItems": 1,
              "description": "Chip values for this cell. May contain multiple to mark the row against more than one chip."
            }
          }
        }
      ]
    },

    "annotated-code": {
      "type": "object",
      "required": ["kind", "source"],
      "additionalProperties": false,
      "properties": {
        "kind": { "const": "annotated-code" },
        "language": { "type": "string" },
        "source": { "type": "string", "description": "Code body. Use (1), (2)... as inline markers; each matches an annotation by id. Annotations may also declare `lines` / `match` externally and skip the inline marker." },
        "annotations": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "content"],
            "additionalProperties": false,
            "properties": {
              "id":      { "type": "integer", "minimum": 1 },
              "content": { "type": "string", "description": "HTML snippet. Allowed inline markup: <code>, <strong>, <em>, <a>." },
              "lines": {
                "type": "string",
                "description": "Optional line spec — '3' for a single line, '1-3' for a range, '1,5-7' for mixed. Hovering the marker highlights every listed line; when no inline (N) marker is present, the chip auto-places on the first listed line. Line numbers are 1-based and match the gutter."
              },
              "match": {
                "oneOf": [
                  { "type": "string" },
                  { "type": "array", "items": { "type": "string" }, "minItems": 1 }
                ],
                "description": "Optional substring(s) of the source. Each occurrence is highlighted on marker hover, so you can point at a token without polluting the source with (N)."
              }
            }
          }
        }
      }
    },

    "step-flow": {
      "type": "object",
      "required": ["kind", "steps"],
      "additionalProperties": false,
      "properties": {
        "kind": { "const": "step-flow" },
        "steps": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["title"],
            "additionalProperties": false,
            "properties": {
              "num": { "type": ["string", "number"] },
              "title": { "type": "string" },
              "meta": { "type": "string", "description": "Small meta line (estimate, files, risk)." },
              "content": { "$ref": "#/$defs/richString" }
            }
          }
        }
      }
    },

    "compare-grid": {
      "type": "object",
      "required": ["kind", "cards"],
      "additionalProperties": false,
      "description": "N-card comparison grid. Use verdict to colour each card; mix `content` (rich text body) and/or `items` (bullet list) freely. The verdict vocabulary covers both quality contrasts (good/bad/neutral) and scope contrasts (in/out) — the kit renders in/out cards with the same border vocabulary scope-grid used previously.",
      "properties": {
        "kind": { "const": "compare-grid" },
        "cards": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["title"],
            "additionalProperties": false,
            "properties": {
              "verdict": {
                "enum": ["good", "bad", "neutral", "in", "out"],
                "default": "neutral",
                "description": "Card accent: good (success border), bad (danger), neutral (default), in (success — was scope-grid status:in), out (muted — was scope-grid status:out)."
              },
              "title": { "type": "string" },
              "content": { "$ref": "#/$defs/richString", "description": "Rich-text body. Combine with items, or use either alone." },
              "items": {
                "type": "array",
                "items": { "$ref": "#/$defs/richString" },
                "description": "Bullet list inside the card. Renders below `content` when both are present."
              }
            }
          }
        }
      }
    },

    "chart": {
      "type": "object",
      "required": ["kind", "type"],
      "additionalProperties": false,
      "description": "Data-driven chart. The `type` field picks the render mode: Cartesian (scatter / line / area / bubble / quadrant) share an SVG plot with axes, pan, zoom, log scale, and PNG export; bar variants render label/value bars; donut renders a distribution arc. Each type has its own payload shape — the renderer dispatches by `type` so unused fields are simply ignored.",
      "properties": {
        "kind": { "const": "chart" },
        "type": {
          "enum": ["scatter", "line", "area", "bubble", "quadrant", "bar", "stacked-bar", "grouped-bar", "donut"],
          "description": "Render mode. scatter / line / area / bubble / quadrant — Cartesian SVG using `series` of {x,y} points. bar — horizontal CSS bars from `rows`. stacked-bar / grouped-bar — multi-series horizontal bars using `categories` + `series.values`. donut — single-ring distribution from `slices`."
        },
        "title": { "type": "string" },
        "x_label": { "type": "string", "description": "Cartesian only (scatter / line / area / bubble / quadrant)." },
        "y_label": { "type": "string", "description": "Cartesian only." },
        "series": {
          "type": "array",
          "description": "Cartesian or stacked-bar / grouped-bar series. For Cartesian: each series carries `data: [{x, y, label, size?}]`. For stacked-bar / grouped-bar: each series carries `values: [number]` aligned to `categories`.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "label": { "type": "string" },
              "color": { "enum": ["accent", "warn", "danger", "success", "muted"], "default": "accent" },
              "data": {
                "type": "array",
                "description": "Cartesian payload — list of points.",
                "items": {
                  "type": "object",
                  "required": ["x", "y"],
                  "additionalProperties": false,
                  "properties": {
                    "x": { "type": "number" },
                    "y": { "type": "number" },
                    "label": { "type": "string" },
                    "size": { "type": "number", "description": "Bubble only. Drives the dot radius (sqrt-scaled so dot area is proportional to size)." }
                  }
                }
              },
              "values": {
                "type": "array",
                "description": "stacked-bar / grouped-bar payload — one numeric value per entry in `categories`.",
                "items": { "type": "number" }
              }
            }
          }
        },
        "rows": {
          "type": "array",
          "description": "Bar only. Required when type is bar. One row per bar.",
          "items": {
            "type": "object",
            "required": ["label", "value"],
            "additionalProperties": false,
            "properties": {
              "label": { "type": "string" },
              "value": { "type": "number" },
              "display": { "type": "string", "description": "Override the right-hand readout (e.g. '95 / 100' instead of '95')." },
              "color": { "enum": ["accent", "warn", "danger", "success"], "default": "accent" }
            }
          }
        },
        "max": { "type": "number", "description": "Bar / stacked-bar / grouped-bar — full-width value. Defaults to the largest row value (bar) or the largest category total (stacked) / category max (grouped)." },
        "categories": {
          "type": "array",
          "description": "stacked-bar / grouped-bar — ordered list of category labels (rows of the chart). Each series.values[] index aligns to this list.",
          "items": { "type": "string" },
          "minItems": 1
        },
        "quadrants": {
          "type": "object",
          "description": "Quadrant chart only. Splits the plot into four regions with reference lines at (x, y) and optionally names each quadrant.",
          "required": ["x", "y"],
          "additionalProperties": false,
          "properties": {
            "x": { "type": "number", "description": "Vertical reference line position on the x-axis." },
            "y": { "type": "number", "description": "Horizontal reference line position on the y-axis." },
            "labels": {
              "type": "array",
              "description": "Four labels in order [top-left, top-right, bottom-left, bottom-right]. Use empty strings to skip a corner.",
              "items": { "type": "string" },
              "minItems": 4,
              "maxItems": 4
            }
          }
        },
        "slices": {
          "type": "array",
          "description": "donut / pie only. Each slice is a labelled value; the renderer normalises to 100%.",
          "items": {
            "type": "object",
            "required": ["label", "value"],
            "additionalProperties": false,
            "properties": {
              "label": { "type": "string" },
              "value": { "type": "number", "minimum": 0 },
              "color": { "enum": ["accent", "warn", "danger", "success", "muted"], "default": "accent" }
            }
          },
          "minItems": 2
        }
      },
      "allOf": [
        {
          "if": { "properties": { "type": { "const": "bar" } }, "required": ["type"] },
          "then": { "required": ["rows"] }
        },
        {
          "if": { "properties": { "type": { "enum": ["scatter", "line", "area", "bubble", "quadrant"] } }, "required": ["type"] },
          "then": { "required": ["series"] }
        },
        {
          "if": { "properties": { "type": { "enum": ["stacked-bar", "grouped-bar"] } }, "required": ["type"] },
          "then": { "required": ["categories", "series"] }
        },
        {
          "if": { "properties": { "type": { "const": "quadrant" } }, "required": ["type"] },
          "then": { "required": ["quadrants"] }
        },
        {
          "if": { "properties": { "type": { "const": "donut" } }, "required": ["type"] },
          "then": { "required": ["slices"] }
        }
      ]
    },

    "diagram": {
      "type": "object",
      "required": ["kind", "source"],
      "additionalProperties": false,
      "properties": {
        "kind": { "const": "diagram" },
        "caption": { "type": "string" },
        "source": { "type": "string", "description": "Mermaid source. Sequence / flow / state / gantt / class supported." }
      }
    },

    "live-snippet": {
      "type": "object",
      "required": ["kind", "source"],
      "additionalProperties": false,
      "properties": {
        "kind": { "const": "live-snippet" },
        "language": { "enum": ["html-css-js"], "default": "html-css-js" },
        "label": { "type": "string" },
        "source": { "type": "string" }
      }
    },

    "richString": {
      "description": "Either a plain string or an array mixing strings with inline nodes.",
      "oneOf": [
        { "type": "string" },
        {
          "type": "array",
          "items": {
            "oneOf": [
              { "type": "string" },
              { "$ref": "#/$defs/inlineNode" }
            ]
          }
        }
      ]
    },

    "inlineNode": {
      "oneOf": [
        {
          "type": "object",
          "required": ["kind"],
          "additionalProperties": false,
          "properties": {
            "kind": { "const": "glossary-term" },
            "term": { "type": "string" },
            "in": { "type": "string", "description": "Disambiguating domain." },
            "lang": { "type": "string", "description": "Override the project language for this instance." },
            "text": { "type": "string", "description": "Visible text; defaults to term." }
          }
        },
        {
          "type": "object",
          "required": ["kind", "name"],
          "additionalProperties": false,
          "properties": {
            "kind": { "const": "ext-ref" },
            "name": { "type": "string" },
            "in": { "type": "string" },
            "lang": { "type": "string" },
            "text": { "type": "string" }
          }
        },
        {
          "type": "object",
          "required": ["kind", "text"],
          "additionalProperties": false,
          "properties": {
            "kind": { "enum": ["code", "em", "strong"] },
            "text": { "type": "string" }
          }
        },
        {
          "type": "object",
          "required": ["kind", "text", "href"],
          "additionalProperties": false,
          "properties": {
            "kind": { "const": "link" },
            "text": { "type": "string" },
            "href": { "type": "string" }
          }
        }
      ]
    }
  }
}
