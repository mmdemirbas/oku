<!-- What needs Markdown and JSON both: an oku-* fence body is JSON. -->
<idea-plugin>
  <extensions defaultExtensionNs="org.intellij.markdown">
    <fenceLanguageProvider implementation="io.github.mmdemirbas.oku.OkuFenceLanguageProvider"/>
  </extensions>
  <extensions defaultExtensionNs="JavaScript.JsonSchema">
    <ContentAwareSchemaFileProvider implementation="io.github.mmdemirbas.oku.OkuFenceSchemaProvider"/>
    <ProviderFactory implementation="io.github.mmdemirbas.oku.OkuFrontMatterSchemaFactory" order="first"/>
  </extensions>
  <applicationListeners>
    <listener class="io.github.mmdemirbas.oku.OkuFenceSchemaReset" topic="io.github.mmdemirbas.oku.OkuGreetingListener"/>
  </applicationListeners>
</idea-plugin>
