"""bin/html-doc — legacy shim; redirects to oku.cli.main() for back-compat.

The project is now called `oku`; this shim keeps existing automation
that calls `bin/html-doc <verb>` working through the 1.x sunset
window. Prefer `bin/oku` (or the installed `oku` console script)
for new invocations.
"""

import sys
from pathlib import Path

_SRC = Path(__file__).resolve().parent.parent / "src"
sys.path.insert(0, str(_SRC))

from oku.cli import main  # noqa: E402  — sys.path adjustment must precede import

if __name__ == "__main__":
    sys.exit(main())
