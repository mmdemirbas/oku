"""bin/oku — thin shim that runs oku.cli.main() without install.

Preferred name. Same payload as the legacy bin/html-doc shim kept
for back-compat through the 1.x sunset window.
"""

import sys
from pathlib import Path

_SRC = Path(__file__).resolve().parent.parent / "src"
sys.path.insert(0, str(_SRC))

from oku.cli import main  # noqa: E402  — sys.path adjustment must precede import

if __name__ == "__main__":
    sys.exit(main())
