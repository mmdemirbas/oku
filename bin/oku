#!/usr/bin/env python3
# /// script
# requires-python = ">=3.10"
# dependencies = [
#     "jsonschema>=4.0",
# ]
# ///
"""bin/oku — thin shim that runs oku.cli.main() without install.

For ad-hoc invocations from a clone of the repo when no install has
happened: `uv run bin/oku serve` or plain `python3 bin/oku serve`
both work. PEP 723 metadata pulls jsonschema into the ephemeral venv
when invoked via uv.
"""

import sys
from pathlib import Path

_SRC = Path(__file__).resolve().parent.parent / "src"
sys.path.insert(0, str(_SRC))

from oku.cli import main  # noqa: E402  — sys.path adjustment must precede import

if __name__ == "__main__":
    sys.exit(main())
