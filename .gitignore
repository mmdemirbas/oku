# OS
.DS_Store

# IDE / Editors
.idea/
*.swp
*~

# Build / Artifacts
build/
dist/
*.egg-info/

# Language: Python
__pycache__/
.venv/
.ruff_cache/
.pytest_cache/

# oku: generated artifacts (build/serve emit these; the recent
# refactor keeps source dirs clean, so these patterns are defensive).
**/site-manifest.json
**/site-manifest.js
**/llms.txt
**/pagefind/
# Root-level symlink dropped by `oku serve` so chrome.js's runtime
# fetch resolves; never tracked.
/pagefind

# Personal / session working files. These are the artifacts a session
# leaves behind — a review write-up, a scratch plan. `commit.md` forbids
# staging them, so ignoring them is the only way `git status` can be
# empty at the end of a session.
SPEC.md
REVIEW.md
TASK.md
SESSION.md
HANDOFF.md
code-review.md
notes/
_internal/
.scratch/

# Tooling: session-local working dirs (Playwright MCP screenshots/logs)
.playwright-mcp/

# Logs / Temp
tmp/
*.log

# Fetched once by `oku vendor`; 3.3 MB of mermaid + Prism, not authored content.
kit/vendor/

# Coverage runs write these to the working directory, and `--cov` is the
# first thing anyone reaches for when auditing this suite. `.coverage`
# alone is not enough: parallel runs write `.coverage.<host>.<pid>.<rand>`
# beside it, and one of those sat untracked in src/ after a review pass.
.coverage
.coverage.*
htmlcov/
coverage.xml
